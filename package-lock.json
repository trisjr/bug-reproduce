{
  "name": "repro",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "repro",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.0.0"
      }
    },
    "node_modules/@repro/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@repro/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@repro/diff": {
      "resolved": "packages/diff",
      "link": true
    },
    "node_modules/@repro/node": {
      "resolved": "packages/sdk",
      "link": true
    },
    "node_modules/@repro/replay": {
      "resolved": "packages/replay",
      "link": true
    },
    "packages/cli": {
      "name": "@repro/cli",
      "version": "0.1.0",
      "dependencies": {
        "@repro/core": "*",
        "@repro/diff": "*",
        "@repro/node": "*",
        "@repro/replay": "*"
      },
      "bin": {
        "repro": "src/bin.ts"
      }
    },
    "packages/core": {
      "name": "@repro/core",
      "version": "0.1.0"
    },
    "packages/diff": {
      "name": "@repro/diff",
      "version": "0.1.0",
      "dependencies": {
        "@repro/core": "*"
      }
    },
    "packages/replay": {
      "name": "@repro/replay",
      "version": "0.1.0",
      "dependencies": {
        "@repro/core": "*"
      }
    },
    "packages/sdk": {
      "name": "@repro/node",
      "version": "0.1.0",
      "dependencies": {
        "@repro/core": "*"
      }
    }
  }
}
